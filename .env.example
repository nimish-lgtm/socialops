# Copy to .env (never commit it). Values below are placeholders.
# MODE: mock (automated tests only) | web (real everything, chat in the browser) | live (real everything over WhatsApp)
MODE=web
# Web: every new browser signs itself up as the owner of a new workspace (capped per day).
SELF_SIGNUP=true
SIGNUPS_PER_DAY=50
PORT=8080
LOG_LEVEL=info
# Admin connection used for migrations; runtime roles socialops_app / socialops_system are created by db:setup.
DATABASE_URL=postgres://socialops_owner:dev@localhost:5432/socialops_dev
DB_ROLE_PASSWORD=dev
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_DIR=./data/media

# Required outside mock (npm run dev generates them into .env). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=
LINK_SECRET=
OPERATOR_TOKEN=

# WhatsApp Cloud API (live only)
WA_GRAPH_VERSION=v20.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Meta app: "connect" login, publishing, and Facebook Page lookups. Publishing stays off until live check L5 passes.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
META_PUBLISH_ENABLED=false

# Public profile lookups from a pasted link (official APIs only, nothing is scraped).
# Instagram Business Discovery: your own IG professional account id and a token for it.
META_LOOKUP_IG_USER_ID=
META_LOOKUP_TOKEN=
# YouTube Data API v3 key (Google Cloud console).
YOUTUBE_API_KEY=

# Model. web/live require anthropic, a key AND a daily budget. fake exists for tests only.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-sonnet-5-5
AI_DAILY_BUDGET_INR=

APPROVAL_TTL_HOURS=24
DELETE_COOLING_DAYS=7
