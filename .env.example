# Copy to .env (never commit it). Values below are placeholders.
# MODE: mock (tests) | sim (browser simulator, no real accounts) | hybrid (real WhatsApp, fake social) | live
MODE=sim
PORT=8080
LOG_LEVEL=info
# Admin connection used for migrations; runtime roles socialops_app / socialops_system are created by db:setup.
DATABASE_URL=postgres://socialops_owner:dev@localhost:5432/socialops_dev
DB_ROLE_PASSWORD=dev
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_DIR=./data/media

# Required outside mock/sim. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=
LINK_SECRET=
OPERATOR_TOKEN=

# WhatsApp Cloud API (hybrid/live)
WA_GRAPH_VERSION=v20.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Meta app for Facebook Page / Instagram professional (live). Publishing stays off until live check L5 passes.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
META_PUBLISH_ENABLED=false

# Model. fake = scripted stand-in. anthropic needs a key AND a daily budget (no budget = no model calls).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-sonnet-5-5
AI_DAILY_BUDGET_INR=

APPROVAL_TTL_HOURS=24
DELETE_COOLING_DAYS=7
